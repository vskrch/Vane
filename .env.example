# Perplexica Environment Variables
# Copy this file to .env.local and fill in your API keys

# OpenAI (recommended for best results)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini / Google AI
GEMINI_API_KEY=...

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Groq (fast inference)
GROQ_API_KEY=gsk_...

# Ollama (local models)
OLLAMA_API_URL=http://localhost:11434

# Optional: SearXNG URL (if you have your own instance)
# If not set, the app will use built-in DuckDuckGo search fallback
SEARXNG_API_URL=

# Optional: App URL for server-side absolute URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
