# Perplexica Environment Variables
# Copy this file to .env.local for local development or set in Heroku Config Vars

# Search API (REQUIRED)
TAVILY_API_KEY=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

# Default LLM Provider - NVIDIA NIM (OpenAI-compatible)
# Get free API key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: Other providers (can be added via settings UI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_API_URL=http://localhost:11434

# App Configuration
# Local: http://localhost:3000
# Heroku: Set this to your Heroku app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Heroku-specific
NODE_ENV=production
